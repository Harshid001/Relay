{
  "name": "relay-support",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/support.test.ts"
  },
  "dependencies": {
    "@tencent-ai/agent-sdk": "0.3.262",
    "express": "4.21.2",
    "lucide-react": "0.563.0",
    "mongodb": "^7.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.19.15",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "concurrently": "8.2.2",
    "postcss": "8.5.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
}
