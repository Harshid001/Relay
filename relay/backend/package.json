{
  "name": "relay-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/support.test.ts tests/unit.test.ts",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:coverage": "c8 --reporter=text --reporter=lcov --check-coverage --lines 52 --branches 68 tsx --test tests/support.test.ts tests/unit.test.ts"
  },
  "dependencies": {
    "@sentry/node": "^9.47.1",
    "@tencent-ai/agent-sdk": "0.3.262",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "mongodb": "^7.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "4.17.21",
    "@types/node": "22.19.15",
    "c8": "^12.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
