# Copy to .env. Never commit secrets. Demo mode works without any key.
CODEBUDDY_LIVE=false
# Opt-in: set to true to seed the sample conversations used by the local demo.
# Unset or false starts with an empty workspace.
SEED_DEMO=true
PORT=3000

# --- MongoDB -----------------------------------------------------------
# Local dev (default): the driver connects to mongodb://127.0.0.1:27017
# Production: use your Atlas connection string.
# MONGODB_URI=mongodb://127.0.0.1:27017
# Separate databases keep demo and live records apart.
# MONGODB_DB=relay

# To use live SDK responses, set CODEBUDDY_LIVE=true and configure:
# CODEBUDDY_API_KEY=your-own-server-side-key
# ADMIN_TOKEN=your-own-long-random-admin-secret
# Optional: CODEBUDDY_AUTH_TOKEN, CODEBUDDY_MODEL, CODEBUDDY_CODE_PATH
# DATA_DIR defaults to this project's data folder (used for local artifacts).
# RELAY_TURN_DELAY_MS adds artificial reply latency (0 by default) so you can
# watch the loading and human hand-off states locally.

# --- Accounts & sessions (recommended for live deployments) ------------
# On first start with no accounts in the database, Relay provisions the
# initial admin from these variables. Password must be >= 12 characters.
# BOOTSTRAP_ADMIN_EMAIL=owner@yourcompany.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-12-chars
# BOOTSTRAP_ADMIN_NAME=Workspace Owner
#
# Sessions are httpOnly cookies (relay_session) with a 30-day sliding TTL.
# Behind a TLS-terminating proxy, enable Secure cookies:
# TRUST_PROXY=1
#
# ADMIN_TOKEN remains supported as a fallback shared-secret path while no
# accounts exist. It is ignored once real accounts are provisioned.
#
# The first email/Google sign-up is an `agent`, not an admin, unless you opt in:
# ALLOW_FIRST_USER_ADMIN=false

# --- Observability (optional) ------------------------------------------
# Sentry: managed error tracking, alert routing and (optional) tracing.
# When SENTRY_DSN is set, Sentry captures exceptions and owns the uncaught
# exception/rejection handlers; without it nothing changes.
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=relay@1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0.1
#
# Dependency-free fallback/additional sink: 5xx responses and unhandled errors
# are also POSTed as JSON to this URL when set.
# ERROR_WEBHOOK_URL=https://example.com/hooks/relay-errors

# --- Google Sign-In & Email Verification (optional) ---------------------
# Google OAuth 2.0 Web Client ID: required to enable Google Sign-In. Without it
# /api/auth/google refuses every token (audience cannot be validated).
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
#
# Comma-separated recipients (max 10). When set, Relay emails the team
# whenever a conversation joins the human queue.
# NOTIFY_EMAILS=team@yourcompany.com
# Delivery uses Resend's HTTP API when a key is provided (also sends OTP codes);
# otherwise notifications and OTP codes are logged to the server console instead.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# NOTIFY_FROM_EMAIL="Relay <support@yourcompany.com>"
#
# Local development only: when true, NODE_ENV is not production and the caller
# is loopback, /api/auth/email/send-code returns the OTP and magic-link token.
# Never enable this on a public deployment.
# ALLOW_AUTH_DEBUG_CODE=false
