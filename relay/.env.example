[TEMPLATE]
# Docker Compose overrides (repo root).
#
# The authoritative, fully documented variable list for running the backend
# lives in backend/.env.example — keep that file as the single source of truth.
# This root file only covers the values docker-compose.yml reads when you run
# `docker compose up` from the repo root.
#
#   cp .env.example .env
#
# Copy to .env. Never commit secrets. Demo mode works without any key.

# Compose passes these into the app container (docker-compose.yml).
CODEBUDDY_LIVE=false
SEED_DEMO=true
# ADMIN_TOKEN=your-own-long-random-admin-secret
# CODEBUDDY_API_KEY=your-own-server-side-key
# MONGODB_DB=relay

# For a plain (non-Docker) backend run, configure backend/.env instead; see
# backend/.env.example for MongoDB, accounts, Google Sign-In, email, etc.
