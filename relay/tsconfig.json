{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "esModuleInterop": true, "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["src/main.tsx", "src/App.tsx", "src/Auth.tsx", "src/ErrorBoundary.tsx", "src/Landing.tsx", "src/admin", "src/customer", "src/ui", "src/service-api.ts", "src/service-types.ts"]
}
