# Production environment template.
# Copy to .env.prod, fill in, and never commit it:
#   cp .env.prod.example .env.prod

# --- Public -------------------------------------------------------------
# Your domain, pointing (A record) at the VM's public IP.
# Use the root domain or a subdomain like relay.yourdomain.com.
DOMAIN=relay.yourdomain.com

# --- Database -----------------------------------------------------------
# Leave MONGODB_URI unset when using the docker-compose mongo service.
# For MongoDB Atlas: MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_URI=
MONGODB_DB=relay
MONGODB_MAX_POOL_SIZE=20
# Demo seeding is opt-in; this is the default, so it can be removed entirely.
SEED_DEMO=false

# --- Database auth (PRD-007, required) ----------------------------------
# The compose mongo service initialises with this root user and enforces
# authentication; the app URI is built from these automatically. Long random
# values: openssl rand -hex 32. The backup scripts read the same file.
MONGO_ROOT_USER=relay-admin
MONGO_ROOT_PASSWORD=change-me-openssl-rand-hex-32

# --- Security -----------------------------------------------------------
# Long random secret: openssl rand -hex 32
ADMIN_TOKEN=change-me-openssl-rand-hex-32
# Extra hostnames (besides DOMAIN) the server answers for, comma-separated.
# Requests with a different Host or Origin header get 403. Set to "*" only if
# you accept losing the cross-site-write protection for cookie sessions.
# ALLOWED_HOSTS=relay-alternate.yourdomain.com
# Required behind the reverse proxy: number of proxy hops in front of the
# app (1 for a single Caddy/nginx; 2 when Cloudflare proxies into Caddy) so
# the app reads the real client IP from X-Forwarded-For.
TRUST_PROXY=1

# --- First admin account (bootstrap runs only while no users exist) -----
BOOTSTRAP_ADMIN_EMAIL=owner@yourdomain.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-12-chars
BOOTSTRAP_ADMIN_NAME=Workspace Owner

# --- Optional: live LLM answers (CodeBuddy) -----------------------------
CODEBUDDY_LIVE=false
# CODEBUDDY_API_KEY=

# --- Google Sign-In & Email Verification (optional) ---------------------
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# RESEND_API_KEY enables email OTP code and magic link delivery.
RESEND_API_KEY=
NOTIFY_EMAILS=
NOTIFY_FROM_EMAIL=Relay <onboarding@resend.dev>

# --- Free-plan caps (optional) ------------------------------------------
# Defaults: 300 conversations / 1,000 AI answers per calendar month.
# Set a limit to 0 to disable that cap entirely.
# FREE_CONVERSATIONS_LIMIT=300
# FREE_AI_MESSAGES_LIMIT=1000

# --- Account policy (optional) ------------------------------------------
# Leave unset so the first self-service sign-up becomes an `agent` (the
# bootstrap admin above is the intended first admin).
# ALLOW_FIRST_USER_ADMIN=false
# Local-development only: never enable on a public deployment.
# ALLOW_AUTH_DEBUG_CODE=false

# --- Observability (recommended) ----------------------------------------
# Managed error tracking + alert routing. Without these, errors only land in
# container logs (monitoring is disabled by default).
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=relay@1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Dependency-free fallback/additional sink: 5xx and unhandled errors are
# POSTed as JSON to this URL when set.
# ERROR_WEBHOOK_URL=https://example.com/hooks/relay-errors

# --- Backups (required before launch, PRD-006) --------------------------
# Nightly mongodump -> Cloudflare R2 via scripts/backup-r2.sh (cron). RPO is
# one night; restores replace the database (--drop), so rehearse on a scratch
# database first. Enable the GitHub workflow too (BACKUP_ENABLED=true +
# MONGODB_URI / R2_* secrets) for off-VM copies with a monthly rehearsal.
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_BUCKET=relay-backups

# --- Cloudflare (optional) ---------------------------------------------
# Only needed if you enable the DNS-01 challenge in the Caddyfile.
# Token needs Zone > DNS > Edit for your zone.
# CF_DNS_API_TOKEN=
