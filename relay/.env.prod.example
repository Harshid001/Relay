# Production environment template.
# Copy to .env.prod, fill in, and never commit it:
#   cp .env.prod.example .env.prod

# --- Public -------------------------------------------------------------
# Your domain, pointing (A record) at the VM's public IP.
# Use the root domain or a subdomain like relay.yourdomain.com.
DOMAIN=relay.yourdomain.com

# --- Database -----------------------------------------------------------
MONGODB_DB=relay
SEED_DEMO=false

# --- Security -----------------------------------------------------------
# Long random secret: openssl rand -hex 32
ADMIN_TOKEN=change-me-openssl-rand-hex-32
# Extra hostnames (besides DOMAIN) the server answers for, comma-separated.
# Requests with a different Host or Origin header get 403. Set to "*" only if
# you accept losing the cross-site-write protection for cookie sessions.
# ALLOWED_HOSTS=relay-alternate.yourdomain.com
# Required behind the reverse proxy: number of proxy hops in front of the
# app (1 for a single Caddy/nginx; 2 when Cloudflare proxies into Caddy) so
# the app reads the real client IP from X-Forwarded-For.
TRUST_PROXY=1

# --- First admin account (bootstrap runs only while no users exist) -----
BOOTSTRAP_ADMIN_EMAIL=owner@yourdomain.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-12-chars
BOOTSTRAP_ADMIN_NAME=Workspace Owner

# --- Optional: live LLM answers (CodeBuddy) -----------------------------
CODEBUDDY_LIVE=false
# CODEBUDDY_API_KEY=

# --- Email notifications (queue escalations) ----------------------------
RESEND_API_KEY=
NOTIFY_EMAILS=
NOTIFY_FROM_EMAIL=Relay <onboarding@resend.dev>

# --- Cloudflare (optional) ---------------------------------------------
# Only needed if you enable the DNS-01 challenge in the Caddyfile.
# Token needs Zone > DNS > Edit for your zone.
# CF_DNS_API_TOKEN=
